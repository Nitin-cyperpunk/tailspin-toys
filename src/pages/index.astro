---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [
  ...new Set(
    games
      .map((game) => game.category?.name)
      .filter((name): name is string => Boolean(name)),
  ),
].sort();
const publishers = [
  ...new Set(
    games
      .map((game) => game.publisher?.name)
      .filter((name): name is string => Boolean(name)),
  ),
].sort();
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="mb-8 grid grid-cols-1 gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-5 sm:grid-cols-2">
            <div>
              <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
                Filter by category
              </label>
              <select
                id="category-filter"
                data-testid="category-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-4 py-3 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All categories</option>
                {categories.map((category) => <option value={category}>{category}</option>)}
              </select>
            </div>

            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
                Filter by publisher
              </label>
              <select
                id="publisher-filter"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-4 py-3 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher}>{publisher}</option>)}
              </select>
            </div>
          </div>

          <p class="sr-only" data-testid="filter-results" role="status" aria-live="polite"></p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="mt-6 hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  const updateFilteredGames = (): void => {
    const selectedCategory = categoryFilter?.value ?? '';
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const matchesCategory = !selectedCategory || card.dataset.category === selectedCategory;
      const matchesPublisher = !selectedPublisher || card.dataset.publisher === selectedPublisher;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (filteredEmptyState) {
      filteredEmptyState.classList.toggle('hidden', visibleCount > 0);
    }

    if (results) {
      results.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
    }
  };

  categoryFilter?.addEventListener('change', updateFilteredGames);
  publisherFilter?.addEventListener('change', updateFilteredGames);
  updateFilteredGames();
</script>
